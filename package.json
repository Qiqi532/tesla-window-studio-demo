{
  "name": "tesla-window-studio-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "verify:gltf": "gltf-transform validate public/assets/tesla-model-3-2018.glb",
    "verify:model": "node scripts/verify-model.mjs",
    "verify:deploy": "node scripts/verify-static-deploy.mjs",
    "prebuild": "npm run verify:gltf && npm run verify:model",
    "test": "node --test --test-isolation=none tests/*.test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.2.1",
    "vite": "8.3.0"
  }
}
