{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://demo.example.com",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 7200
    }
  ]
}
